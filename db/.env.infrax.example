# TEMPLATE ONLY. No credentials are stored in this repository.
# Select ONE environment and use only its hosts from neon.environments.json.
APP_ENV=development
NEON_PROJECT_ID=spring-glitter-25305067
NEON_BRANCH_ID=br-holy-mode-bcenb3y8
PGDATABASE=infrax
# Pooled TLS URL for the scoped SERVER-SIDE application login (not browser/Expo public env).
# Application login/secret-manager bindings must be provisioned before enabling traffic.
DATABASE_URL=
# Direct TLS owner/migration URL. Never use the owner credential for a public client.
DATABASE_URL_UNPOOLED=
# Retain the intended Better Auth/Payload integration. Do not enable a second auth store.
PAYLOAD_SECRET=
BETTER_AUTH_SECRET=
INFRAX_PUBLIC_ORIGIN=
# Keep integrations off until source rights, credentials and workers are ready.
INFRAX_AI_ENABLED=false
INFRAX_INGESTION_ENABLED=false
INFRAX_NOTIFICATION_DISPATCH_ENABLED=false
