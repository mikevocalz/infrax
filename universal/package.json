{
  "name": "@infrax/universal-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["mobile", "web"],
  "engines": {"node": ">=24.22.1"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "npm run build --workspace=@infrax/research-web",
    "dev:web": "npm run dev --workspace=@infrax/research-web",
    "dev:mobile": "npm run start --workspace=@infrax/research-mobile",
    "bundle:native": "npm run bundle --workspace=@infrax/research-mobile"
  },
  "dependencies": {
    "@nyc-tron/core": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v0.1.0-alpha.4/nyc-tron-core-0.1.0-alpha.4.tgz",
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v0.1.0-alpha.4/nyc-tron-ui-0.1.0-alpha.4.tgz",
    "@nyc-tron/reserved-regions": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v0.1.0-alpha.4/nyc-tron-reserved-regions-0.1.0-alpha.4.tgz",
    "react": "19.3.1", "react-dom": "19.3.1", "react-native": "0.88.1", "react-native-web": "0.21.4", "zustand": "5.0.8"
  },
  "devDependencies": {"@types/node":"24.10.0","@types/react":"19.3.0","@types/react-dom":"19.3.0","typescript":"6.0.3"}
}
