# Server only. Never prefix credentials with NEXT_PUBLIC_ or EXPO_PUBLIC_.
APP_ENV=development
INFRAX_ENV=development
INFRAX_PUBLIC_ORIGIN=http://localhost:3000
# Restricted CMS login: infrax_cms_development. Not the owner, not the API role.
INFRAX_CMS_DATABASE_URL=
PAYLOAD_SECRET=
BETTER_AUTH_SECRET=
INFRAX_AUTH_BASE_URL=http://localhost:3000/api/auth
INFRAX_ALLOW_SIGNUP=false
# Separate restricted infrastructure API login: infrax_api_development.
INFRAX_RUNTIME_DATABASE_URL=
# No production launch or automatic data imports are enabled.
INFRAX_PRODUCTION_ENABLED=false
# Never set CI or INFRAX_CMS_TEST_MODE on an application host.
