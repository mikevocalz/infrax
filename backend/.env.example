# Server-only. Never prefix any database/provider/auth secret with NEXT_PUBLIC_ or EXPO_PUBLIC_.
INFRAX_ENV=development
INFRAX_PUBLIC_ORIGIN=http://localhost:3000
# Obtain the restricted infrax_api_development login from the dedicated InFraX project.
# Exact pooled development host is validated by config.mjs. No owner fallback exists.
INFRAX_RUNTIME_DATABASE_URL=
# The single self-managed Payload/Better Auth service, once actually mounted:
INFRAX_AUTH_BASE_URL=http://localhost:3000/api/payload/auth
INFRAX_PRODUCTION_ENABLED=false
# Separate restricted ingestion connection, not the API runtime or migration owner:
INFRAX_INGEST_DATABASE_URL=
EIA_API_KEY=
